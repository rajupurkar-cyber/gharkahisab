<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Ghar Ka Hisab">
<title>Ghar Ka Hisab Family</title>
<style>
  :root {
    --green: #10B981;
    --red: #EF4444;
    --blue: #3B82F6;
    --orange: #F59E0B;
    --purple: #8B5CF6;
    --bg: #F8FAFC;
    --card: #FFFFFF;
    --border: #E2E8F0;
    --text: #1E293B;
    --text2: #64748B;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { 
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; 
    background: linear-gradient(135deg, var(--bg) 0%, #F1F5F9 100%);
    color: var(--text); 
    min-height: 100vh;
  }

  /* LOGIN SCREEN */
  .login-screen {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--green) 0%, var(--blue) 100%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .login-screen.active {
    display: flex;
  }

  .login-container {
    text-align: center;
    color: white;
    max-width: 400px;
  }

  .login-container h1 {
    font-size: 36px;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .login-container p {
    font-size: 16px;
    color: rgba(255,255,255,0.9);
    margin-bottom: 40px;
  }

  .family-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 30px;
  }

  .family-btn {
    padding: 24px;
    border: none;
    background: rgba(255,255,255,0.2);
    border-radius: 16px;
    color: white;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    border: 2px solid transparent;
  }

  .family-btn:hover {
    background: rgba(255,255,255,0.3);
    transform: scale(1.05);
  }

  .family-btn:active {
    background: rgba(255,255,255,0.4);
    border-color: white;
    transform: scale(0.98);
  }

  .nav { 
    display: flex; 
    flex-direction: column;
    background: linear-gradient(180deg, #059669 0%, #10B981 50%, #06B6D4 100%);
    border-right: 4px solid var(--green); 
    position: fixed; 
    left: 0;
    top: 0;
    width: 100px;
    height: 100vh;
    z-index: 100;
    padding: 20px 0;
    overflow-y: auto;
    gap: 10px;
    align-items: center;
    box-shadow: 8px 0 20px rgba(16, 185, 129, 0.15);
  }

  .nav-btn { 
    flex-shrink: 0;
    padding: 18px 10px; 
    border: none; 
    background: rgba(255,255,255,0.15);
    border-radius: 16px;
    font-size: 11px; 
    color: rgba(255,255,255,0.8);
    cursor: pointer; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    gap: 6px; 
    font-family: inherit;
    width: 85px;
    transition: all 0.3s ease;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .nav-btn:hover {
    background: rgba(255,255,255,0.25);
    transform: scale(1.08);
  }

  .nav-btn.active { 
    background: rgba(255,255,255,0.35);
    color: white;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.3);
    transform: scale(1.12);
  }

  body { 
    margin-left: 100px;
  }

  .page-header { 
    background: linear-gradient(135deg, var(--green) 0%, var(--blue) 100%);
    padding: 20px 16px;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .page-header h2 { font-size: 22px; font-weight: 700; }
  .page-header .user-info { font-size: 12px; }
  .logout-btn { 
    padding: 6px 12px; 
    background: rgba(255,255,255,0.2); 
    color: white; 
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 8px; 
    cursor: pointer; 
    font-size: 11px; 
    font-weight: 600;
    font-family: inherit;
    transition: all 0.3s;
  }
  .logout-btn:hover { background: rgba(255,255,255,0.3); }

  .section { display: none; padding: 14px; padding-bottom: 30px; }
  .section.active { display: block; }

  .card { 
    background: var(--card); 
    border-radius: 14px; 
    padding: 16px; 
    margin-bottom: 12px; 
    border: 1px solid var(--border);
  }
  .card-title { font-size: 15px; font-weight: 700; margin-bottom: 12px; }

  .metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 12px; }
  .metric { 
    background: var(--card); 
    border-radius: 12px; 
    padding: 14px; 
    text-align: center; 
    border: 1px solid var(--border);
  }
  .metric-label { font-size: 10px; color: var(--text2); margin-bottom: 4px; font-weight: 600; text-transform: uppercase; }
  .metric-value { font-size: 18px; font-weight: 700; }
  .c-green { color: var(--green); } .c-red { color: var(--red); } .c-blue { color: var(--blue); }

  .entry { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
    padding: 10px 0; 
    border-bottom: 1px solid var(--border); 
  }
  .entry:last-child { border-bottom: none; }
  .entry-icon { 
    width: 36px; 
    height: 36px; 
    border-radius: 10px; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    font-size: 16px; 
    flex-shrink: 0;
  }
  .entry-info { flex: 1; min-width: 0; }
  .entry-name { font-size: 13px; font-weight: 600; }
  .entry-meta { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .entry-right { text-align: right; }
  .entry-amount { font-size: 14px; font-weight: 700; }
  .empty { text-align: center; color: var(--text2); font-size: 13px; padding: 24px 0; }

  .toggle-row { 
    display: flex; 
    background: var(--card); 
    border-radius: 14px; 
    padding: 3px; 
    margin-bottom: 14px; 
    border: 1px solid var(--border);
  }
  .toggle-btn { 
    flex: 1; 
    padding: 11px; 
    border: none; 
    background: transparent; 
    border-radius: 11px; 
    font-size: 14px; 
    font-weight: 600; 
    cursor: pointer; 
    font-family: inherit; 
    color: var(--text2); 
  }
  .toggle-btn.income.active { background: var(--green); color: white; }
  .toggle-btn.expense.active { background: var(--red); color: white; }

  .field { margin-bottom: 14px; }
  .field label { 
    font-size: 11px; 
    font-weight: 600; 
    color: var(--text); 
    text-transform: uppercase; 
    letter-spacing: 0.4px; 
    display: block; 
    margin-bottom: 6px; 
  }
  select, input, textarea {
    width: 100%; 
    padding: 11px 12px; 
    border: 1px solid var(--border);
    border-radius: 11px; 
    font-size: 14px; 
    background: var(--bg);
    color: var(--text); 
    font-family: inherit;
  }
  .amount-wrap { position: relative; }
  .amount-wrap .rupee { 
    position: absolute; 
    left: 12px; 
    top: 50%; 
    transform: translateY(-50%); 
    font-size: 16px; 
    font-weight: 700; 
    color: var(--text2); 
  }
  .amount-wrap input { padding-left: 30px; font-size: 22px; font-weight: 700; }
  textarea { resize: none; min-height: 70px; font-size: 13px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .save-btn { 
    width: 100%; 
    padding: 14px; 
    border: none; 
    border-radius: 11px; 
    font-size: 15px; 
    font-weight: 700; 
    cursor: pointer; 
    font-family: inherit; 
    margin-top: 6px; 
  }
  .save-btn.income { background: linear-gradient(135deg, var(--green) 0%, #059669 100%); color: white; }
  .save-btn.expense { background: linear-gradient(135deg, var(--red) 0%, #DC2626 100%); color: white; }

  .bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .bar-label { font-size: 11px; color: var(--text2); width: 85px; text-align: right; flex-shrink: 0; }
  .bar-track { flex: 1; height: 14px; background: var(--bg); border-radius: 7px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 7px; transition: width 0.4s; }
  .bar-val { font-size: 11px; color: var(--text2); width: 65px; flex-shrink: 0; font-weight: 600; text-align: right; }

  .month-row { display: flex; gap: 8px; margin-bottom: 12px; }
  .month-row select { flex: 1; }

  .sync-status { 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    background: var(--card); 
    border-radius: 11px; 
    padding: 10px 12px; 
    margin-bottom: 12px; 
    border: 1px solid var(--border);
    font-size: 12px;
  }
  .sync-dot { width: 7px; height: 7px; border-radius: 50%; }
  .dot-green { background: var(--green); }
  .dot-red { background: var(--red); }
</style>
</head>
<body>

<!-- LOGIN SCREEN -->
