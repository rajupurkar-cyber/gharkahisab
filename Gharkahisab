<script>
const SHEET_ID = "1pSYmR1HVdYu-QRl9ReD8yvuD14_4H0aYmXcJK6COvMQ";
const CSV_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv`;
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyaWUqGhni06fl1KM2V4QNi1ThNdfq0_l4hg-dVCkZZNE8TUB4sd-7jBZIu4ExhRaY-TQ/exec";
const DRIVE_BACKUP_URL = "https://script.google.com/macros/s/AKfycbwtwDbtxST5uCSpcPcArzmDKZNjt82YxH6fonpoSxS_R77gQWNRg4M2M7XQ92Ypj5TN/exec";

const FAMILY_MEMBERS = ['Rajendra', 'Pratibha', 'Abhishek', 'Monali'];
const CATS = {'Grocery':'🛒','Petrol':'⛽','Light Bill':'💡','Pipeline Gas Bill':'🔥','Loan EMI':'🏦','Medicine':'💊','Mobile Recharge':'📱','Water Bill':'💧','House Maintenance':'🔧','Clothing':'👕','Transport':'🚗','Doctor':'🏥','Eating Out':'🍽️','Other':'📌','Pension':'🏛️','Son transfer':'👨‍👦','Interest / FD':'🏧','Salary':'💼','Vegetables':'🥦','Milk & Dairy':'🥛','Internet Bill':'🌐','Rent':'🏠','Insurance':'🛡️'};
const COLORS = {'Grocery':'#10B981','Petrol':'#F59E0B','Light Bill':'#3B82F6','Pipeline Gas Bill':'#EF4444','Loan EMI':'#DC2626','Medicine':'#65A30D','Other':'#6B7280','Mobile Recharge':'#8B5CF6','Water Bill':'#06B6D4','House Maintenance':'#D97706','Clothing':'#EC4899','Transport':'#6B7280','Doctor':'#7C3AED','Eating Out':'#84CC16','Vegetables':'#84CC16','Milk & Dairy':'#06B6D4','Internet Bill':'#8B5CF6','Rent':'#3B82F6','Insurance':'#F59E0B','Salary':'#3B82F6'};
const MODE_COLORS = {'SBI':'#3B82F6','AXIS':'#EF4444','BHIM':'#10B981','GPay':'#65A30D','Cash':'#6B7280'};

let currentUser = null;
let allData = {};
let goals = {};
let recurring = {};
let currentType = 'income';

// Initialize data structure for each family member
FAMILY_MEMBERS.forEach(member => {
  allData[member] = JSON.parse(localStorage.getItem(`gkh_data_${member}`) || '[]');
  goals[member] = JSON.parse(localStorage.getItem(`gkh_goals_${member}`) || '[]');
  recurring[member] = JSON.parse(localStorage.getItem(`gkh_recurring_${member}`) || '[]');
});

function saveData() {
  if (currentUser) {
    localStorage.setItem(`gkh_data_${currentUser}`, JSON.stringify(allData[currentUser]));
    localStorage.setItem(`gkh_goals_${currentUser}`, JSON.stringify(goals[currentUser]));
    localStorage.setItem(`gkh_recurring_${currentUser}`, JSON.stringify(recurring[currentUser]));
    
    // Backup to Google Drive
    backupToGoogleDrive();
  }
}

async function backupToGoogleDrive() {
  try {
    // Only backup current user's data, not all data
    const backupData = {
      user: currentUser,
      dataCount: allData[currentUser].length,
      goalsCount: goals[currentUser].length,
      recurringCount: recurring[currentUser].length,
      timestamp: new Date().toISOString(),
      lastEntry: allData[currentUser].length > 0 ? allData[currentUser][allData[currentUser].length - 1] : null
    };
    
    // Send only metadata first
    const metaResponse = await fetch(DRIVE_BACKUP_URL, {
      method: 'POST',
      body: JSON.stringify(backupData),
      headers: { 'Content-Type': 'application/json' }
    });
    
    const result = await metaResponse.json();
    
    if (result.status === 'ok') {
      alert('✅ Backup saved to Google Drive!');
      console.log('Backup status:', result);
    }
  } catch (e) {
    console.log('Drive backup status:', e);
    alert('Backup in progress (offline mode)');
  }
}

function login(user) {
  currentUser = user;
  document.getElementById('login-screen').classList.remove('active');
  document.getElementById('main-app').style.display = 'block';
  document.getElementById('user-display').textContent = `👤 ${user}`;
  
  fillDropdowns();
  renderAll();
  loadFromSheet();
}

function logout() {
  currentUser = null;
  document.getElementById('login-screen').classList.add('active');
  document.getElementById('main-app').style.display = 'none';
  showTab('dashboard');
}

function getData() { return allData[currentUser] || []; }
function getGoals() { return goals[currentUser] || []; }
function getRecurring() { return recurring[currentUser] || []; }

function fmt(n) { return '₹' + Math.round(n).toLocaleString('en-IN'); }

async function loadFromSheet() {
  document.getElementById('sync-msg').textContent = 'Syncing...';
  try {
    const response = await fetch(CSV_URL + '?t=' + Date.now());
    const csv = await response.text();
    
    const lines = csv.trim().split('\n');
    
    lines.forEach((line, idx) => {
      if (idx === 0 || !line.trim()) return;
      
      const parts = parseCSVLine(line);
      if (parts[0] && parts[0].trim()) {
        const entry = {
          id: parts[0].trim(),
          date: parts[1]?.trim() || '',
          type: parts[2]?.trim() || '',
          category: parts[3]?.trim() || '',
          source: parts[3]?.trim() || '',
          amount: parseFloat(parts[4]) || 0,
          bank: parts[5]?.trim() || '',
          note: parts[6]?.trim() || ''
        };
        
        // Determine which user this entry belongs to based on context
        // For now, add to current user
        if (entry.amount > 0) {
          const exists = allData[currentUser].find(e => e.id === entry.id);
          if (!exists) {
            allData[currentUser].push(entry);
          }
        }
      }
    });
    
    saveData();
    fillDropdowns();
    renderAll();
    document.getElementById('sync-msg').textContent = '✓ Synced';
    document.getElementById('sync-dot').className = 'sync-dot dot-green';
  } catch (e) {
    console.error('Load error:', e);
    document.getElementById('sync-msg').textContent = '⚠️ Using offline data';
    document.getElementById('sync-dot').className = 'sync-dot dot-red';
  }
}

function parseCSVLine(line) {
  const result = [];
  let current = '';
  let inQuotes = false;
  
  for (let i = 0; i < line.length; i++) {
    const char = line[i];
    if (char === '"') {
      inQuotes = !inQuotes;
    } else if (char === ',' && !inQuotes) {
      result.push(current.replace(/^"|"$/g, ''));
      current = '';
    } else {
      current += char;
    }
  }
  result.push(current.replace(/^"|"$/g, ''));
  return result;
}

function getMonths() {
  const s = new Set();
  const now = new Date();
  for (let i = 0; i < 12; i++) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    s.add(d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'));
  }
  getData().forEach(e => { if (e.date) s.add(String(e.date).slice(0, 7)); });
  return [...s].sort().reverse();
}

function monthLabel(m) {
  const [y, mo] = m.split('-');
  return new Date(y, mo - 1, 1).toLocaleString('en-IN', { month: 'long', year: 'numeric' });
}

function fillDropdowns() {
  const months = getMonths();
  const cur = new Date().getFullYear() + '-' + String(new Date().getMonth() + 1).padStart(2, '0');
  ['dash-month','hist-month','ana-month'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = months.map(m => `<option value="${m}"${m === cur ? ' selected' : ''}>${monthLabel(m)}</option>`).join('');
  });
}

function getFiltered(month) {
  return getData().filter(e => e.date && String(e.date).slice(0, 7) === month);
}

function entryHTML(e) {
  const icon = e.type === 'income' ? (CATS[e.source] || '💰') : (CATS[e.category] || '📌');
  const name = e.type === 'income' ? e.source : e.category;
  const meta = (e.note ? e.note + ' · ' : '') + e.date + ' · ' + e.bank;
  const color = e.type === 'income' ? 'c-green' : 'c-red';
  const sign = e.type === 'income' ? '+' : '-';
  const bg = e.type === 'income' ? 'rgba(16,185,129,0.1)' : 'rgba(239,68,68,0.1)';
  return `<div class="entry"><div class="entry-icon" style="background:${bg}">${icon}</div><div class="entry-info"><div class="entry-name">${name}</div><div class="entry-meta">${meta}</div></div><div class="entry-right"><div class="entry-amount ${color}">${sign}${fmt(e.amount)}</div></div></div>`;
}

function renderDashboard() {
  const m = document.getElementById('dash-month').value;
  const entries = getFiltered(m);
  const income = entries.filter(e => e.type === 'income').reduce((s, e) => s + e.amount, 0);
  const expense = entries.filter(e => e.type === 'expense').reduce((s, e) => s + e.amount, 0);
  const bal = income - expense;
  
  document.getElementById('d-income').textContent = fmt(income);
  document.getElementById('d-expense').textContent = fmt(expense);
  const bEl = document.getElementById('d-balance');
  bEl.textContent = fmt(bal);
  bEl.className = 'metric-value ' + (bal >= 0 ? 'c-blue' : 'c-red');
  document.getElementById('d-savings').textContent = fmt(Math.max(0, bal));

  const recent = entries.slice().sort((a, b) => String(b.date).localeCompare(String(a.date))).slice(0, 5);
  document.getElementById('d-recent').innerHTML = recent.length === 0 ? '<div class="empty">No entries yet</div>' : recent.map(e => entryHTML(e)).join('');
}

function setType(type) {
  currentType = type;
  document.getElementById('tbtn-income').classList.toggle('active', type === 'income');
  document.getElementById('tbtn-expense').classList.toggle('active', type === 'expense');
  document.getElementById('income-fields').style.display = type === 'income' ? 'block' : 'none';
  document.getElementById('expense-fields').style.display = type === 'expense' ? 'block' : 'none';
  const btn = document.getElementById('save-btn');
  btn.textContent = type === 'income' ? 'Save Income' : 'Save Expense';
  btn.className = 'save-btn ' + type;
}

function saveEntry() {
  const amt = parseFloat(document.getElementById('f-amount').value);
  if (!amt || amt <= 0) { alert('Please enter valid amount'); return; }
  const date = document.getElementById('f-date').value;
  if (!date) { alert('Please select a date'); return; }
  const cat = currentType === 'income' ? document.getElementById('f-source').value : document.getElementById('f-category').value;
  
  const entry = {
    id: Date.now(),
    type: currentType,
    date: date,
    source: cat,
    category: cat,
    amount: amt,
    bank: document.getElementById('f-bank').value,
    note: document.getElementById('f-note').value || ''
  };
  
  allData[currentUser].push(entry);
  saveData();
  
  fillDropdowns();
  renderAll();
  document.getElementById('f-amount').value = '';
  document.getElementById('f-note').value = '';
  alert('✅ Saved!');
  showTab('dashboard');
}

function addGoal() {
  const name = document.getElementById('goal-name').value.trim();
  const target = parseFloat(document.getElementById('goal-target').value);
  if (!name || !target || target <= 0) { alert('Please fill all fields'); return; }
  
  goals[currentUser].push({
    id: Date.now(),
    name: name,
    target: target,
    progress: 0
  });
  
  saveData();
  renderGoals();
  document.getElementById('goal-name').value = '';
  document.getElementById('goal-target').value = '';
  alert('✅ Goal added!');
}

function renderGoals() {
  const el = document.getElementById('goals-list');
  const goalsList = getGoals();
  if (goalsList.length === 0) {
    el.innerHTML = '<div class="empty">No goals yet</div>';
  } else {
    el.innerHTML = goalsList.map((g, i) => {
      const pct = Math.round((g.progress / g.target) * 100);
      return `<div style="margin-bottom:12px;padding:12px;background:var(--bg);border-radius:12px">
        <div style="font-weight:600;margin-bottom:6px">${g.name}</div>
        <div style="background:var(--card);height:12px;border-radius:6px;overflow:hidden;margin-bottom:6px"><div style="background:var(--green);height:100%;width:${pct}%"></div></div>
        <div style="font-size:11px;color:var(--text2)">${fmt(g.progress)} / ${fmt(g.target)} (${pct}%)</div>
      </div>`;
    }).join('');
  }
}

function addRecurring() {
  const name = document.getElementById('rec-name').value.trim();
  const amount = parseFloat(document.getElementById('rec-amount').value);
  const day = parseInt(document.getElementById('rec-day').value);
  if (!name || !amount || !day || day < 1 || day > 31) { alert('Please fill all fields'); return; }
  
  recurring[currentUser].push({
    id: Date.now(),
    name: name,
    amount: amount,
    day: day
  });
  
  saveData();
  renderRecurring();
  document.getElementById('rec-name').value = '';
  document.getElementById('rec-amount').value = '';
  document.getElementById('rec-day').value = '';
  alert('✅ Recurring bill added!');
}

function renderRecurring() {
  const el = document.getElementById('recurring-list');
  const recurList = getRecurring();
  if (recurList.length === 0) {
    el.innerHTML = '<div class="empty">No recurring bills</div>';
  } else {
    el.innerHTML = recurList.map((r, i) => `
      <div class="entry">
        <div class="entry-icon" style="background:rgba(239,68,68,0.1)">🔄</div>
        <div class="entry-info">
          <div class="entry-name">${r.name}</div>
          <div class="entry-meta">₹${r.amount} on day ${r.day}</div>
        </div>
      </div>
    `).join('');
  }
}

function renderAnalytics() {
  const m = document.getElementById('ana-month').value;
  const entries = getFiltered(m);
  const expenses = entries.filter(e => e.type === 'expense');
  const income = entries.filter(e => e.type === 'income').reduce((s, e) => s + e.amount, 0);
  const expense = expenses.reduce((s, e) => s + e.amount, 0);
  
  const catTotals = {};
  expenses.forEach(e => { catTotals[e.category] = (catTotals[e.category] || 0) + e.amount; });
  const maxCat = Math.max(1, ...Object.values(catTotals));
  
  document.getElementById('ana-bars').innerHTML = !Object.keys(catTotals).length ? '<div class="empty">No expenses</div>' : Object.entries(catTotals).sort((a, b) => b[1] - a[1]).map(([cat, amt]) => {
    const pct = Math.round(amt / maxCat * 100);
    const col = COLORS[cat] || '#888';
    return `<div class="bar-row"><div class="bar-label">${cat}</div><div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${col}"></div></div><div class="bar-val">${fmt(amt)}</div></div>`;
  }).join('');

  document.getElementById('ana-comparison').innerHTML = `
    <div class="bar-row">
      <div class="bar-label">Income</div>
      <div class="bar-track"><div class="bar-fill" style="width:50%;background:var(--green)"></div></div>
      <div class="bar-val">${fmt(income)}</div>
    </div>
    <div class="bar-row">
      <div class="bar-label">Expense</div>
      <div class="bar-track"><div class="bar-fill" style="width:50%;background:var(--red)"></div></div>
      <div class="bar-val">${fmt(expense)}</div>
    </div>
  `;
}

function renderHistory() {
  const m = document.getElementById('hist-month').value;
  const f = document.getElementById('hist-filter').value;
  let entries = getFiltered(m).sort((a, b) => String(b.date).localeCompare(String(a.date)));
  if (f === 'income') entries = entries.filter(e => e.type === 'income');
  if (f === 'expense') entries = entries.filter(e => e.type === 'expense');
  const el = document.getElementById('hist-list');
  el.innerHTML = entries.length === 0 ? '<div class="card"><div class="empty">No entries found</div></div>' : '<div class="card">' + entries.map(e => entryHTML(e)).join('') + '</div>';
}

function showTab(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('sec-' + id).classList.add('active');
  document.getElementById('nav-' + id).classList.add('active');
  if (id === 'analytics') renderAnalytics();
  if (id === 'goals') renderGoals();
  if (id === 'recurring') renderRecurring();
}

function renderAll() {
  renderDashboard();
  renderHistory();
  renderGoals();
  renderRecurring();
}

document.getElementById('f-date').value = new Date().toISOString().slice(0, 10);
</script>
