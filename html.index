<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ghar Ka Hisab - Family Finance</title>
<style>
:root { --green: #10B981; --red: #EF4444; --blue: #3B82F6; --bg: #F8FAFC; --card: #FFFFFF; --border: #E2E8F0; --text: #1E293B; --text2: #64748B; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: linear-gradient(135deg, var(--bg) 0%, #F1F5F9 100%); min-height: 100vh; }

.login-screen { display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, var(--green) 0%, var(--blue) 100%); z-index: 1000; flex-direction: column; align-items: center; justify-content: center; padding: 20px; }
.login-screen.hidden { display: none; }
.login-container { text-align: center; color: white; }
.login-container h1 { font-size: 48px; margin-bottom: 10px; }
.login-container p { font-size: 18px; margin-bottom: 50px; opacity: 0.9; }
.family-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
.family-btn { padding: 30px; background: rgba(255,255,255,0.2); border: 2px solid rgba(255,255,255,0.3); border-radius: 16px; color: white; font-size: 18px; font-weight: 700; cursor: pointer; transition: all 0.3s; }
.family-btn:hover { background: rgba(255,255,255,0.3); transform: scale(1.05); }
.family-btn:active { background: rgba(255,255,255,0.4); }

.main-app { display: none; padding: 20px; max-width: 600px; margin: 0 auto; }
.main-app.visible { display: block; }

.header { background: linear-gradient(135deg, var(--green) 0%, var(--blue) 100%); color: white; padding: 20px; border-radius: 14px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
.header h1 { font-size: 24px; }
.user-info { font-size: 14px; opacity: 0.9; }
.logout-btn { padding: 8px 16px; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: white; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; }

.section { display: none; }
.section.active { display: block; }

.card { background: var(--card); border-radius: 14px; padding: 16px; margin-bottom: 14px; border: 1px solid var(--border); }
.card-title { font-size: 16px; font-weight: 700; margin-bottom: 12px; }

.field { margin-bottom: 14px; }
.field label { font-size: 11px; font-weight: 600; color: var(--text); text-transform: uppercase; display: block; margin-bottom: 6px; }
.field input, .field select, .field textarea { width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 11px; font-size: 14px; font-family: inherit; }
.field textarea { min-height: 70px; resize: none; }

.btn { width: 100%; padding: 14px; border: none; border-radius: 11px; font-size: 15px; font-weight: 700; cursor: pointer; font-family: inherit; margin-top: 6px; }
.btn-income { background: linear-gradient(135deg, var(--green) 0%, #059669 100%); color: white; }
.btn-expense { background: linear-gradient(135deg, var(--red) 0%, #DC2626 100%); color: white; }

.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
.metric { background: var(--card); border-radius: 12px; padding: 14px; text-align: center; border: 1px solid var(--border); }
.metric-label { font-size: 10px; color: var(--text2); margin-bottom: 4px; font-weight: 600; text-transform: uppercase; }
.metric-value { font-size: 20px; font-weight: 700; }

.nav { display: flex; gap: 10px; margin-bottom: 20px; background: var(--card); padding: 10px; border-radius: 12px; border: 1px solid var(--border); }
.nav-btn { flex: 1; padding: 10px; background: transparent; border: none; border-radius: 8px; font-size: 12px; cursor: pointer; font-weight: 600; color: var(--text2); transition: all 0.3s; }
.nav-btn.active { background: var(--green); color: white; }

.empty { text-align: center; color: var(--text2); padding: 20px; }
.success { color: var(--green); padding: 10px; background: rgba(16,185,129,0.1); border-radius: 8px; margin-bottom: 10px; }
</style>
</head>
<body>

<div class="login-screen" id="loginScreen">
  <div class="login-container">
    <h1>🏠 Ghar Ka Hisab</h1>
    <p>Family Finance Manager</p>
    <div class="family-buttons">
      <button class="family-btn" onclick="login('Rajendra')">👨 Rajendra</button>
      <button class="family-btn" onclick="login('Pratibha')">👩 Pratibha</button>
      <button class="family-btn" onclick="login('Abhishek')">👦 Abhishek</button>
      <button class="family-btn" onclick="login('Monali')">👧 Monali</button>
    </div>
  </div>
</div>

<div class="main-app" id="mainApp">
  <div class="header">
    <div><h1>🏠 Ghar Ka Hisab</h1><div class="user-info" id="userDisplay">Welcome!</div></div>
    <button class="logout-btn" onclick="logout()">Logout</button>
  </div>

  <div class="nav">
    <button class="nav-btn active" onclick="showSection('dashboard')">📊 Dashboard</button>
    <button class="nav-btn" onclick="showSection('add')">➕ Add</button>
    <button class="nav-btn" onclick="showSection('history')">📋 History</button>
  </div>

  <!-- DASHBOARD -->
  <div class="section active" id="dashboard">
    <div class="card">
      <div class="card-title">📊 Dashboard</div>
      <div class="metric-grid">
        <div class="metric">
          <div class="metric-label">💰 Income</div>
          <div class="metric-value" id="totalIncome" style="color: var(--green)">₹0</div>
        </div>
        <div class="metric">
          <div class="metric-label">💸 Expense</div>
          <div class="metric-value" id="totalExpense" style="color: var(--red)">₹0</div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">🕐 Recent Entries</div>
      <div id="recentEntries"></div>
    </div>
  </div>

  <!-- ADD ENTRY -->
  <div class="section" id="add">
    <div class="card">
      <div class="card-title">➕ Add Entry</div>
      <div class="field">
        <label>Type</label>
        <select id="entryType">
          <option value="income">💰 Income</option>
          <option value="expense">💸 Expense</option>
        </select>
      </div>
      <div class="field">
        <label>Amount (₹)</label>
        <input type="number" id="amount" placeholder="0" inputmode="decimal">
      </div>
      <div class="field">
        <label>Category</label>
        <select id="category">
          <option>Grocery</option>
          <option>Petrol</option>
          <option>Salary</option>
          <option>Pension</option>
          <option>Light Bill</option>
          <option>Other</option>
        </select>
      </div>
      <div class="field">
        <label>Date</label>
        <input type="date" id="entryDate">
      </div>
      <div class="field">
        <label>Notes (optional)</label>
        <textarea id="notes" placeholder="Add notes..."></textarea>
      </div>
      <button class="btn btn-income" onclick="addEntry()">Save Entry</button>
      <div id="message"></div>
    </div>
  </div>

  <!-- HISTORY -->
  <div class="section" id="history">
    <div class="card">
      <div class="card-title">📋 All Entries</div>
      <div id="entriesList"></div>
    </div>
  </div>
</div>

<script>
let currentUser = null;
let userDataMap = {};

// Initialize empty data for each user
['Rajendra', 'Pratibha', 'Abhishek', 'Monali'].forEach(user => {
  userDataMap[user] = JSON.parse(localStorage.getItem(`gkh_${user}`) || '[]');
});

function login(user) {
  currentUser = user;
  document.getElementById('loginScreen').classList.add('hidden');
  document.getElementById('mainApp').classList.add('visible');
  document.getElementById('userDisplay').textContent = `👤 ${user}`;
  document.getElementById('entryDate').valueAsDate = new Date();
  renderDashboard();
}

function logout() {
  currentUser = null;
  document.getElementById('loginScreen').classList.remove('hidden');
  document.getElementById('mainApp').classList.remove('visible');
  showSection('dashboard');
}

function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  
  if (id === 'history') renderHistory();
  if (id === 'dashboard') renderDashboard();
}

function addEntry() {
  const type = document.getElementById('entryType').value;
  const amount = parseFloat(document.getElementById('amount').value);
  const category = document.getElementById('category').value;
  const date = document.getElementById('entryDate').value;
  const notes = document.getElementById('notes').value;
  
  if (!amount || amount <= 0) { alert('Please enter valid amount'); return; }
  if (!date) { alert('Please select date'); return; }
  
  const entry = { id: Date.now(), type, amount, category, date, notes };
  userDataMap[currentUser].push(entry);
  localStorage.setItem(`gkh_${currentUser}`, JSON.stringify(userDataMap[currentUser]));
  
  // Show success
  document.getElementById('message').innerHTML = '<div class="success">✅ Entry saved!</div>';
  document.getElementById('amount').value = '';
  document.getElementById('notes').value = '';
  
  setTimeout(() => { document.getElementById('message').innerHTML = ''; }, 2000);
  
  renderDashboard();
}

function renderDashboard() {
  const entries = userDataMap[currentUser] || [];
  const income = entries.filter(e => e.type === 'income').reduce((s, e) => s + e.amount, 0);
  const expense = entries.filter(e => e.type === 'expense').reduce((s, e) => s + e.amount, 0);
  
  document.getElementById('totalIncome').textContent = '₹' + income.toLocaleString('en-IN');
  document.getElementById('totalExpense').textContent = '₹' + expense.toLocaleString('en-IN');
  
  const recent = entries.slice(-5).reverse();
  document.getElementById('recentEntries').innerHTML = recent.length === 0 ? '<div class="empty">No entries yet</div>' : recent.map(e => `<div style="padding:10px;border-bottom:1px solid var(--border)"><strong>${e.category}</strong> - ₹${e.amount} (${e.date})</div>`).join('');
}

function renderHistory() {
  const entries = userDataMap[currentUser] || [];
  document.getElementById('entriesList').innerHTML = entries.length === 0 ? '<div class="empty">No entries</div>' : entries.map(e => `<div style="padding:10px;border-bottom:1px solid var(--border)"><strong>${e.type.toUpperCase()}</strong> - ${e.category} - ₹${e.amount} (${e.date})</div>`).join('');
}

document.getElementById('entryDate').valueAsDate = new Date();
</script>
</body>
</html>
